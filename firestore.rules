rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let data = getUserData();
      return isEmailVerified() && (
        request.auth.token.email == "igonaugustobarbosa@gmail.com" || 
        (data != null && data.role == "admin")
      );
    }

    function getUserTenantId() {
      let data = getUserData();
      return data != null ? data.tenantId : null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'email', 'tenantId', 'role']) &&
               data.id is string &&
               data.email is string &&
               data.tenantId is string &&
               data.role in ['admin', 'technician', 'viewer'];
      }

      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (request.query.limit <= 10 && request.query.filters.size() > 0 && request.query.filters[0].op == '==' && request.query.filters[0].field == 'email')
      );
      allow create: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || (userId == request.auth.uid && incoming().role == resource.data.role && incoming().tenantId == resource.data.tenantId));
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.tenantId == getUserTenantId());
      allow create: if isSignedIn() && (isAdmin() || incoming().tenantId == getUserTenantId());
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.tenantId == getUserTenantId()));
    }

    match /technicians/{technicianId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.tenantId == getUserTenantId());
      allow create: if isSignedIn() && (isAdmin() || incoming().tenantId == getUserTenantId());
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.tenantId == getUserTenantId()));
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.tenantId == getUserTenantId());
      allow create: if isSignedIn() && (isAdmin() || incoming().tenantId == getUserTenantId());
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.tenantId == getUserTenantId()));
    }

    match /serviceOrders/{orderId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.tenantId == getUserTenantId());
      allow create: if isSignedIn() && (isAdmin() || incoming().tenantId == getUserTenantId());
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.tenantId == getUserTenantId()));
    }

    match /workOrders/{woId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.tenantId == getUserTenantId());
      allow create: if isSignedIn() && (isAdmin() || incoming().tenantId == getUserTenantId());
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.tenantId == getUserTenantId()));
    }

    match /settings/{settingId} {
      allow read: if isSignedIn() && (settingId == getUserTenantId() || isAdmin() || settingId == 'global');
      allow write: if isSignedIn() && (settingId == getUserTenantId() || isAdmin());
    }

    match /activities/{activityId} {
      allow list: if isSignedIn() && (resource.data.tenantId == getUserTenantId() || isAdmin());
      allow get: if isSignedIn() && (resource.data.tenantId == getUserTenantId() || isAdmin());
      allow create: if isSignedIn() && incoming().tenantId == getUserTenantId();
      allow update, delete: if isAdmin();
    }
  }
}
